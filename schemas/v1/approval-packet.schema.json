{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-graduation.org/schemas/v1/approval-packet.schema.json",
  "title": "Trust Graduation Approval Packet",
  "type": "object",
  "required": ["protocol", "version", "packetId", "actionClass", "riskClass", "approvalRequired", "context", "decisions"],
  "properties": {
    "protocol": { "const": "trust-graduation" },
    "version": { "type": "string" },
    "packetId": { "type": "string" },
    "workspace": { "type": "string" },
    "requestedBy": { "type": "string" },
    "actionClass": { "type": "string" },
    "riskClass": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "externalSideEffects": { "type": "string" },
    "approvalRequired": { "type": "boolean" },
    "receiptRequired": { "type": "boolean" },
    "reason": { "type": "string" },
    "context": { "type": "object" },
    "evidence": { "type": "object" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "effect"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "effect": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

