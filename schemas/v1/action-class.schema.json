{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gomission.io/spec/trust-graduation/0.1/action-class.schema.json",
  "title": "Trust Graduation Action Class",
  "type": "object",
  "required": ["actionClass", "riskClass", "minimumLevel", "requiresApproval", "externalSideEffects"],
  "properties": {
    "actionClass": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
      "examples": ["read.context", "draft.compose", "email.send.external", "payment.initiate"]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lane": { "type": "string", "enum": ["observe", "prepare", "stage", "act", "ask", "learn", "govern"] },
    "riskClass": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "minimumLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
    "requiresApproval": { "type": "boolean" },
    "receiptRequired": { "type": "boolean" },
    "humanOnly": { "type": "boolean" },
    "externalSideEffects": { "type": "string" },
    "constraints": { "type": "object" },
    "description": { "type": "string" }
  },
  "additionalProperties": false
}
