{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-graduation.org/schemas/v1/evidence.schema.json",
  "title": "Trust Graduation Evidence Event",
  "type": "object",
  "required": ["actionClass", "type"],
  "properties": {
    "eventId": { "type": "string" },
    "actionClass": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "approved",
        "edited",
        "rejected",
        "held",
        "executed",
        "receipt_logged",
        "outcome_positive",
        "outcome_negative",
        "trust_issue",
        "rollback",
        "policy_exception",
        "edited_and_accepted",
        "sent_with_receipt"
      ]
    },
    "principal": { "type": "string" },
    "agent": { "type": "string" },
    "source": { "type": "string" },
    "sourceType": {
      "type": "string",
      "enum": ["receipt", "principal", "connector", "model_inferred"]
    },
    "source_type": {
      "type": "string",
      "enum": ["receipt", "principal", "connector", "model_inferred"]
    },
    "decisionWeight": { "type": "number", "minimum": -1, "maximum": 1 },
    "decision_weight": { "type": "number", "minimum": -1, "maximum": 1 },
    "provenanceWeight": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance_weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceWeight": { "type": "number", "minimum": -1, "maximum": 1 },
    "evidence_weight": { "type": "number", "minimum": -1, "maximum": 1 },
    "actor": { "type": "string" },
    "decisionId": { "type": "string" },
    "approvalPacketId": { "type": "string" },
    "receiptId": { "type": "string" },
    "outcomeId": { "type": "string" },
    "editDistance": { "type": "number", "minimum": 0 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "metadata": { "type": "object" },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
