{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gomission.io/spec/trust-graduation/0.1/decision.schema.json",
  "title": "Trust Graduation Decision",
  "type": "object",
  "required": ["protocol", "version", "allowed", "needsApproval", "status", "mode", "autonomyLevel", "tier", "policy", "evidence", "reason"],
  "properties": {
    "protocol": { "const": "trust-graduation" },
    "version": { "type": "string" },
    "decisionId": { "type": "string" },
    "requestedAction": { "type": "object" },
    "actionClass": { "type": "string" },
    "allowed": { "type": "boolean" },
    "needsApproval": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["allowed", "allowed_with_constraints", "review_required", "deferred", "blocked", "human_only"]
    },
    "mode": {
      "type": "string",
      "enum": ["allowed", "supervised", "auto_capped", "approval_required", "review_only", "insufficient_evidence", "denied", "approved_once", "human_only"]
    },
    "autonomyLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
    "tier": { "type": "string", "enum": ["gated", "supervised", "auto_capped", "review"] },
    "policy": { "$ref": "action-class.schema.json" },
    "evidence": { "type": "object" },
    "constraints": {
      "type": "object",
      "properties": {
        "internal_only": { "type": "boolean" },
        "staging_only": { "type": "boolean" },
        "dry_run_only": { "type": "boolean" },
        "max_amount": { "type": "number", "minimum": 0 },
        "rate_limit": {
          "type": "object",
          "required": ["count", "window"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "window": { "type": "string" }
          }
        },
        "recipient_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "domain_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expires_at": { "type": "string", "format": "date-time" },
        "requires_witness": { "type": "boolean" },
        "redaction_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reason": { "type": "string" },
    "graduationPath": {
      "type": "object",
      "properties": {
        "needed": { "type": "number", "minimum": 0 },
        "current": { "type": "number", "minimum": 0 },
        "next_best_action": {
          "type": "string",
          "enum": ["prepareApprovalPacket", "request_principal_approval", "run_dry_run", "collect_receipt", "reduce_scope", "stop"]
        },
        "safe_fallback_action_class": { "type": "string" },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "packet": { "$ref": "approval-packet.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
